rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['credits', 'plan', 'paid', 'tokens', 'trial']));
      allow create: if signedIn() && request.auth.uid == uid
                    && (!request.resource.data.keys().hasAny(['credits', 'plan', 'paid', 'tokens', 'trial']));
      allow delete: if false;

      match /mobileCreations/{creationId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.ownerId == uid
          && (!('archivedAt' in request.resource.data) || request.resource.data.archivedAt == null || request.resource.data.archivedAt is number);
        allow delete: if isOwner(uid);
      }
      // Operational records are written only by the authenticated cloud service.
      match /{collection}/{document} {
        allow read: if isOwner(uid) && collection in ['studioProjects', 'studioConcepts', 'studioJobs', 'studioConversations'];
        allow write: if false;
      }
      match /private/{doc} {
        allow read, write: if false;
      }
    }

    match /assets/{assetId} {
      allow read: if resource == null || resource.data.visibility == 'public' || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /pipelines/{runId} {
      allow read, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Publication, moderation, private reports, blocks and aggregate votes are
    // authorized by the cloud API. Clients cannot bypass its review queue.
    match /communityGames/{document=**} {
      allow read, write: if false;
    }
    match /communityReports/{document=**} {
      allow read, write: if false;
    }
    match /communityModeration/{document=**} {
      allow read, write: if false;
    }

    // Account API keys are strictly managed by the Cloud API. Direct client reads and writes are denied.
    match /apiKeys/{keyHash} {
      allow read, write: if false;
    }
    match /rateQuotas/{keyHash} {
      allow read, write: if false;
    }
  }
}
