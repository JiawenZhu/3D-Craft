rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['credits', 'plan', 'paid', 'tokens', 'trial']));
      allow create: if signedIn() && request.auth.uid == uid
                    && (!request.resource.data.keys().hasAny(['credits', 'plan', 'paid', 'tokens', 'trial']));
      allow delete: if false;

      match /mobileCreations/{creationId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['name','kind','createdAt','preview','source','ownerId','projectId','conceptIds','selectionKnown','prompt','modelStoragePath'])
          && request.resource.data.ownerId == uid
          && request.resource.data.source == 'ios'
          && (!('projectId' in request.resource.data) || request.resource.data.projectId is string)
          && (!('conceptIds' in request.resource.data) || (request.resource.data.conceptIds is list && request.resource.data.conceptIds.size() <= 4))
          && (!('selectionKnown' in request.resource.data) || request.resource.data.selectionKnown is bool)
          && (!('prompt' in request.resource.data) || (request.resource.data.prompt is string && request.resource.data.prompt.size() <= 12000))
          && (!('modelStoragePath' in request.resource.data) || request.resource.data.modelStoragePath == '' || request.resource.data.modelStoragePath.matches('users/' + uid + '/models/[a-f0-9]{64}[.]glb'))
          && request.resource.data.name is string && request.resource.data.name.size() <= 1000
          && request.resource.data.kind in ['Concept image','3D object']
          && request.resource.data.createdAt is number
          && request.resource.data.preview is string && request.resource.data.preview.size() <= 650000
          && (request.resource.data.preview == '' || request.resource.data.preview.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'));
        allow delete: if isOwner(uid);
      }
      // Operational records are written only by the authenticated cloud service.
      match /{collection}/{document} {
        allow read: if isOwner(uid) && collection in ['studioProjects', 'studioConcepts', 'studioJobs', 'studioConversations'];
        allow write: if false;
      }
      match /private/{doc} {
        allow read, write: if false;
      }
    }

    match /assets/{assetId} {
      allow read: if resource == null || resource.data.visibility == 'public' || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /pipelines/{runId} {
      allow read, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /communityGames/{gameId} {
      // Anyone can view community games
      allow read: if true;

      // Only signed-in users can create a game, and must set ownerId to their own UID
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.creator is string && request.resource.data.creator.size() <= 60
        && request.resource.data.url is string && request.resource.data.url.size() <= 2048;

      // Only the creator can modify details or delete; voters can update vote aggregates
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'likes', 'updatedAt'])
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /votes/{userId} {
        allow read: if true;
        allow write: if signedIn() && request.auth.uid == userId;
      }
    }
  }
}
