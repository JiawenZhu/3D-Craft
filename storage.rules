rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Originals, concept images, previews and animated characters:
    // Previews can be read publicly (used in games/shared views);
    // source files, concepts and animations require owner authentication.
    match /users/{uid}/{category}/{file} {
      allow read: if category == 'previews'
        || file.matches('.*[.](glb|png|jpg|jpeg|webp)')
        || (
          request.auth != null && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && !firestore.exists(/databases/(default)/documents/accountDeletions/$(request.auth.uid))
          && category in ['files', 'images', 'animations']
        );
      allow write: if false;
    }
    match /users/{uid}/models/{file} {
      function owner() {
        return request.auth != null && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && !firestore.exists(/databases/(default)/documents/accountDeletions/$(request.auth.uid));
      }
      // Models are SHA-256 content-addressed and readable by games and 3D viewers
      allow read: if true;
      allow create: if owner() && file.matches('[a-f0-9]{64}[.]glb')
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType == 'model/gltf-binary';
      allow update: if false;
      allow delete: if owner();
    }
  }
}
